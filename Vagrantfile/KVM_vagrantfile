# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Seguimos usando generic/rocky9 (soporta libvirt nativamente)
  config.vm.box = "generic/rocky9"

  # =========================================================
  # SCRIPT DE APROVISIONAMIENTO COMÚN
  # =========================================================
  $provision_script = <<-SCRIPT
    echo "=== [1/5] Configurando Zona Horaria ==="
    timedatectl set-timezone America/Montevideo

    echo "=== [2/5] Configurando Resolución Local (/etc/hosts) ==="
    cat <<EOF >> /etc/hosts
192.168.56.10 server.rhcsa.lab server
192.168.56.11 client.rhcsa.lab client
EOF

    echo "=== [3/5] Configurando SSH ==="
    sed -i 's/^PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config
    sed -i 's/^#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config
    systemctl restart sshd
    echo "root:redhat" | chpasswd
    echo "vagrant:redhat" | chpasswd

    echo "=== [4/5] Instalando Herramientas Base ==="
    dnf update -y
    dnf install -y vim bash-completion man-pages tar net-tools bind-utils lsof tmux stratis-cli stratisd

    echo "=== [5/5] Ajustes de Consola ==="
    echo "alias vi=vim" >> /etc/profile
  SCRIPT

  # =========================================================
  # VM 1: SERVER (KVM / Libvirt)
  # =========================================================
  config.vm.define "server" do |server|
    server.vm.hostname = "server.rhcsa.lab"
    server.vm.network "private_network", ip: "192.168.56.10"

    server.vm.provider :libvirt do |libvirt|
      libvirt.memory = 1024
      libvirt.cpus = 1
      
      # En KVM, usamos qcow2 y el bus virtio (idéntico al examen real)
      libvirt.storage :file, :size => '25G', :type => 'qcow2', :bus => 'virtio'
    end

    server.vm.provision "shell", inline: $provision_script
  end

  # =========================================================
  # VM 2: CLIENT (KVM / Libvirt)
  # =========================================================
  config.vm.define "client" do |client|
    client.vm.hostname = "client.rhcsa.lab"
    client.vm.network "private_network", ip: "192.168.56.11"

    client.vm.provider :libvirt do |libvirt|
      libvirt.memory = 1024
      libvirt.cpus = 1
      
      # Disco extra para el cliente
      libvirt.storage :file, :size => '25G', :type => 'qcow2', :bus => 'virtio'
    end

    client.vm.provision "shell", inline: $provision_script
  end
end
